# ──────────────────────────────────────────────────────────────────────────
# locoworker configuration — copy to .env and fill in what you need.
# Every variable below is actually read by the code. Unused/legacy settings
# (e.g. COWORK_MIROFISH_*, COWORK_AUDIT_ENABLED in old docs) were removed or
# wired up; see README.md → Security model.
# ──────────────────────────────────────────────────────────────────────────

# ── Provider credentials (never pass these to child processes) ─────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1
LMSTUDIO_BASE_URL=http://localhost:1234/v1

# ── Core agent ─────────────────────────────────────────────────────────────
COWORK_PROVIDER=ollama            # anthropic|openai|ollama|lmstudio|deepseek|openrouter
COWORK_MODEL=                     # provider default when empty
COWORK_PERMISSION_MODE=standard    # read-only|constrained|standard|elevated|full|dangerous
COWORK_MAX_TURNS=50
COWORK_MAX_TOKENS=4096
COWORK_CONTEXT_WINDOW=100000
COWORK_HOME=                      # default ~/.cowork
COWORK_PROJECT=                   # desktop: project path to open
COWORK_ENABLE_GRAPHIFY=false
COWORK_WIKI_ENABLED=true
COWORK_MARKETPLACE_URL=           # marketplace client base URL

# ── Embeddings (memory hybrid search) ──────────────────────────────────────
COWORK_EMBEDDER_URL=
COWORK_EMBEDDER_MODEL=
COWORK_EMBEDDER_API_KEY=

# ── Sandboxing / network ───────────────────────────────────────────────────
COWORK_SANDBOX_MODE=none          # none|docker|podman (needs a local runtime)
COWORK_SANDBOX_ENABLED=true      # enforce the outbound HttpFetch allowlist (opt out with "false")
COWORK_BASH_IMAGE=ubuntu:24.04  # container image for sandboxed Bash; pin by digest in production
COWORK_SANDBOX_ALLOWLIST=         # comma-separated hosts, e.g. docs.example.com
COWORK_BIND_HOST=                 # default 127.0.0.1; non-loopback requires a token
COWORK_AUDIT_ENABLED=true         # set false to disable audit writes

# ── Telemetry / dashboard ──────────────────────────────────────────────────
COWORK_TELEMETRY_ENABLED=false
COWORK_TELEMETRY_CONSOLE=false
COWORK_OTLP_ENDPOINT=http://localhost:4318/v1/traces
COWORK_DASHBOARD_PORT=3720
COWORK_DASHBOARD_AUTH_TOKEN=      # >=16 chars; ephemeral token printed if empty (loopback)

# ── Kairos daemon ──────────────────────────────────────────────────────────
COWORK_KAIROS_ENABLED=false
COWORK_KAIROS_FILE_WATCH=false

# ── Orchestrator ───────────────────────────────────────────────────────────
COWORK_WORKER_COUNT=3
COWORK_COORDINATOR_PLANNING=false

# ── OpenClaw gateway (HTTP + Telegram) ─────────────────────────────────────
COWORK_OPENCLAW_ENABLED=false
COWORK_GATEWAY_PORT=4242
COWORK_GATEWAY_HOST=127.0.0.1
COWORK_GATEWAY_RATE_LIMIT=20
COWORK_GATEWAY_AUTH_TOKEN=        # >=16 chars; required for non-loopback binds; one token = one sender identity
COWORK_GATEWAY_WEBHOOK_SECRET=    # enables POST /webhook with HMAC-SHA256 signatures
COWORK_GATEWAY_ALLOWED_SENDERS=   # optional comma-separated sender IDs
COWORK_TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_TOKEN=               # legacy alias
TELEGRAM_ALLOWED_CHATS=           # comma-separated numeric chat IDs

# ── Hermes MCP server ──────────────────────────────────────────────────────
COWORK_HERMES_ENABLED=false
COWORK_HERMES_TRANSPORT=stdio     # stdio|sse
COWORK_HERMES_PORT=3100
COWORK_HERMES_HOST=127.0.0.1
COWORK_HERMES_AUTH_TOKEN=         # >=16 chars for SSE / non-loopback
# Case-insensitive canonical names or aliases. When empty, only read-only tools
# (Read, Glob, Grep, WikiRead, WikiSearch, MemorySearch) are exposed.
COWORK_HERMES_TOOL_ALLOWLIST=read,glob,grep

# ── Voice (experimental, requires external services) ──────────────────────
COWORK_STT_PROVIDER=whisper
COWORK_TTS_PROVIDER=elevenlabs
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
