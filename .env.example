# ──────────────────────────────────────────────────────────────────────────
# locoworker configuration — copy to .env and fill in what you need.
# Every variable below is actually read by the code. Unused/legacy settings
# (e.g. COWORK_MIROFISH_*, COWORK_AUDIT_ENABLED in old docs) were removed or
# wired up; see README.md → Security model.
# ──────────────────────────────────────────────────────────────────────────

# ── Provider credentials (never pass these to child processes) ─────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1
LMSTUDIO_BASE_URL=http://localhost:1234/v1

# ── Core agent ─────────────────────────────────────────────────────────────
COWORK_PROVIDER=ollama            # anthropic|openai|ollama|lmstudio|deepseek|openrouter
COWORK_MODEL=                     # provider default when empty
COWORK_PERMISSION_MODE=standard    # read-only|constrained|standard|elevated|full|dangerous
COWORK_MAX_TURNS=50
COWORK_MAX_TOKENS=4096
COWORK_CONTEXT_WINDOW=100000
COWORK_HOME=                      # default ~/.cowork
COWORK_PROJECT=                   # desktop: project path to open
COWORK_ENABLE_GRAPHIFY=false
COWORK_WIKI_ENABLED=true
COWORK_MARKETPLACE_URL=           # marketplace client base URL

# ── Embeddings (memory hybrid search) ──────────────────────────────────────
COWORK_EMBEDDER_URL=
COWORK_EMBEDDER_MODEL=
COWORK_EMBEDDER_API_KEY=

# ── Sandboxing / network ───────────────────────────────────────────────────
COWORK_SANDBOX_MODE=none          # none|docker|podman (needs a local runtime)
COWORK_SANDBOX_ENABLED=true      # enforce the outbound HttpFetch allowlist (opt out with "false")
COWORK_BASH_IMAGE=ubuntu:24.04  # container image for sandboxed Bash; pin by digest in production
COWORK_SANDBOX_ALLOWLIST=         # comma-separated hosts, e.g. docs.example.com
COWORK_BIND_HOST=                 # default 127.0.0.1; non-loopback requires a token
COWORK_AUDIT_ENABLED=true         # set false to disable audit writes

# ── Resource limits (R-11) ─────────────────────────────────────────────────
# Trusted, operator-level caps read by packages/security/src/utils/resourceLimits.ts.
# These are NEVER read from a project-local settings.json (that file is untrusted,
# so it must not be able to raise its own bounds). Out-of-range values fall back
# to the safe default rather than disabling a cap.
COWORK_MAX_SESSIONS=1000           # max distinct gateway chat sessions (LRU + TTL)
COWORK_SESSION_TTL_MS=1800000      # absolute session lifetime (30 min)
COWORK_MAX_OUTBOX_PRINCIPALS=1000  # max distinct outbox owners
COWORK_OUTBOX_TTL_MS=1800000       # absolute outbox lifetime (30 min)
COWORK_MAX_STATE_BYTES=8388608     # approximate byte ceiling per state map (8 MiB)
COWORK_MAX_SSE_CONNECTIONS=32      # concurrent Hermes /sse connections
COWORK_SSE_IDLE_MS=300000          # absolute SSE connection lifetime (5 min)
COWORK_SSE_HEARTBEAT_MS=15000      # SSE heartbeat interval
COWORK_MAX_REQUEST_BYTES=1048576   # HTTP body cap enforced before JSON parsing
COWORK_MAX_MCP_LINE_BYTES=1048576  # max buffered MCP stdio line (1 MiB)
COWORK_MAX_MCP_PENDING=64          # max in-flight MCP requests / queued stdio lines
COWORK_MCP_REQUEST_TIMEOUT_MS=30000
COWORK_MAX_AUDIT_SCAN_BYTES=8388608  # global byte budget for one audit tail scan
COWORK_MAX_AUDIT_FILES=30            # max audit NDJSON files scanned per call
COWORK_MAX_AUDIT_ROWS=10000          # hard cap for AuditLog.read(0)
COWORK_MAX_AUDIT_LINE_BYTES=262144   # max single audit NDJSON line
COWORK_MAX_AUDIT_EXPORT_ROWS=5000    # hard cap for /api/actions/export-logs
COWORK_MAX_AUDIT_EXPORT_BYTES=8388608

# ── Supply chain (R-13) ────────────────────────────────────────────────────
# Trusted operator policy. Defaults are DENY: no MCP server starts, no plugin
# installs without a trusted signing key, and no template postInstall runs.
# These are NEVER read from a project settings.json, MCP config, marketplace
# index or template definition.
# Bare names are resolved through the operator's PATH; absolute paths are OK.
COWORK_MCP_ALLOW_SERVERS=         # comma-separated MCP server names to consent to
COWORK_MCP_ALLOWED_COMMANDS=      # comma-separated executables MCP servers may spawn
COWORK_TEMPLATE_ALLOW_POSTINSTALL=false  # true|1 to enable template postInstall at all
COWORK_TEMPLATE_ALLOWED_COMMANDS= # comma-separated executables postInstall may spawn
COWORK_PLUGIN_TRUSTED_KEY=        # Ed25519 public key (PEM or base64); also ~/.cowork/plugin-keys.json
COWORK_MCP_MAX_TOOLS_PER_SERVER=64
COWORK_MCP_MAX_TOOLS_TOTAL=256
COWORK_MCP_MAX_DESCRIPTION_CHARS=2000
COWORK_TEMPLATE_MAX_FILES=500
COWORK_TEMPLATE_MAX_FILE_BYTES=524288
COWORK_TEMPLATE_MAX_TOTAL_BYTES=8388608
COWORK_TEMPLATE_POSTINSTALL_TIMEOUT_MS=60000

# ── Telemetry / dashboard ──────────────────────────────────────────────────
COWORK_TELEMETRY_ENABLED=false
COWORK_TELEMETRY_CONSOLE=false
COWORK_OTLP_ENDPOINT=http://localhost:4318/v1/traces
COWORK_DASHBOARD_PORT=3720
COWORK_DASHBOARD_AUTH_TOKEN=      # >=16 chars; ephemeral token printed if empty (loopback)

# ── Kairos daemon ──────────────────────────────────────────────────────────
COWORK_KAIROS_ENABLED=false
COWORK_KAIROS_FILE_WATCH=false

# ── Orchestrator ───────────────────────────────────────────────────────────
COWORK_WORKER_COUNT=3
COWORK_COORDINATOR_PLANNING=false

# ── OpenClaw gateway (HTTP + Telegram) ─────────────────────────────────────
COWORK_OPENCLAW_ENABLED=false
COWORK_GATEWAY_PORT=4242
COWORK_GATEWAY_HOST=127.0.0.1
COWORK_GATEWAY_RATE_LIMIT=20
COWORK_GATEWAY_AUTH_TOKEN=        # >=16 chars; required for non-loopback binds; one token = one sender identity
COWORK_GATEWAY_WEBHOOK_SECRET=    # enables POST /webhook with HMAC-SHA256 signatures
COWORK_GATEWAY_ALLOWED_SENDERS=   # optional comma-separated sender IDs
COWORK_TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_TOKEN=               # legacy alias
TELEGRAM_ALLOWED_CHATS=           # comma-separated numeric chat IDs

# ── Hermes MCP server ──────────────────────────────────────────────────────
COWORK_HERMES_ENABLED=false
COWORK_HERMES_TRANSPORT=stdio     # stdio|sse
COWORK_HERMES_PORT=3100
COWORK_HERMES_HOST=127.0.0.1
COWORK_HERMES_AUTH_TOKEN=         # >=16 chars for SSE / non-loopback
# Case-insensitive canonical names or aliases. When empty, only read-only tools
# (Read, Glob, Grep, WikiRead, WikiSearch, MemorySearch) are exposed.
COWORK_HERMES_TOOL_ALLOWLIST=read,glob,grep

# ── Voice (experimental, requires external services) ──────────────────────
COWORK_STT_PROVIDER=whisper
COWORK_TTS_PROVIDER=elevenlabs
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
